{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluegrass.invalid/contracts/domain/protocol.schema.json",
  "$comment": "Frozen native protocolconfig/config.go v1. Run test_contracts.py with its registered formats; raw duplicate keys and 16 KiB wire bound are checked before JSON decoding.",
  "$ref": "#/$defs/ProtocolConfig",
  "$defs": {
    "SOCKS5": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "username": {
              "const": ""
            },
            "password": {
              "const": ""
            }
          }
        },
        {
          "required": [
            "username",
            "password"
          ],
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\u0000\r\n]+$",
              "format": "bluegrass-secret-255"
            },
            "password": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\u0000\r\n]+$",
              "format": "bluegrass-secret-255"
            }
          }
        }
      ]
    },
    "HTTP": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "username": {
              "const": ""
            },
            "password": {
              "const": ""
            }
          }
        },
        {
          "required": [
            "username",
            "password"
          ],
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\u0000\r\n]+$",
              "format": "bluegrass-secret-1024",
              "allOf": [
                {
                  "not": {
                    "pattern": ":"
                  }
                }
              ]
            },
            "password": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\u0000\r\n]+$",
              "format": "bluegrass-secret-1024"
            }
          }
        }
      ]
    },
    "TLS": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverName"
      ],
      "properties": {
        "serverName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "format": "bluegrass-server-name"
        },
        "alpn": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[!-~]{1,255}$(?![\\s\\S])"
          }
        }
      }
    },
    "Shadowsocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "password"
      ],
      "properties": {
        "method": {
          "enum": [
            "aes-128-gcm",
            "aes-256-gcm",
            "chacha20-ietf-poly1305",
            "2022-blake3-aes-128-gcm",
            "2022-blake3-aes-256-gcm",
            "2022-blake3-chacha20-poly1305"
          ]
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\u0000\r\n]+$",
          "format": "bluegrass-secret-1024"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "2022-blake3-aes-128-gcm"
              }
            }
          },
          "then": {
            "properties": {
              "password": {
                "pattern": "^[A-Za-z0-9+/]{21}[AQgw]==$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "2022-blake3-aes-256-gcm",
                  "2022-blake3-chacha20-poly1305"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "password": {
                "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
              }
            }
          }
        }
      ]
    },
    "VMess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "security",
        "transport"
      ],
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$(?![\\s\\S])",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "security": {
          "enum": [
            "aes-128-gcm",
            "chacha20-poly1305"
          ]
        },
        "transport": {
          "const": "tcp"
        }
      }
    },
    "VLESS": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "transport"
      ],
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$(?![\\s\\S])",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "transport": {
          "const": "tcp"
        },
        "flow": {
          "enum": [
            "",
            "xtls-rprx-vision"
          ]
        }
      }
    },
    "Trojan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password",
        "transport"
      ],
      "properties": {
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\u0000\r\n]+$",
          "format": "bluegrass-secret-1024"
        },
        "transport": {
          "const": "tcp"
        }
      }
    },
    "Hysteria2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\u0000\r\n]+$",
          "format": "bluegrass-secret-1024"
        },
        "obfs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "password"
          ],
          "properties": {
            "type": {
              "const": "salamander"
            },
            "password": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\u0000\r\n]+$",
              "format": "bluegrass-secret-1024"
            }
          }
        }
      }
    },
    "TUIC": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "password",
        "congestionControl",
        "udpRelayMode"
      ],
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$(?![\\s\\S])",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\u0000\r\n]+$",
          "format": "bluegrass-secret-1024"
        },
        "congestionControl": {
          "enum": [
            "cubic",
            "new_reno",
            "bbr"
          ]
        },
        "udpRelayMode": {
          "enum": [
            "native",
            "quic"
          ]
        }
      }
    },
    "AnyTLS": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\u0000\r\n]+$",
          "format": "bluegrass-secret-1024"
        }
      }
    },
    "ProtocolConfig": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "socks5"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "const": 1,
              "format": "bluegrass-int"
            },
            "type": {
              "const": "socks5"
            },
            "socks5": {
              "$ref": "#/$defs/SOCKS5"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "shadowsocks"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "const": 1,
              "format": "bluegrass-int"
            },
            "type": {
              "const": "shadowsocks"
            },
            "shadowsocks": {
              "$ref": "#/$defs/Shadowsocks"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "vmess"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "const": 1,
              "format": "bluegrass-int"
            },
            "type": {
              "const": "vmess"
            },
            "vmess": {
              "$ref": "#/$defs/VMess"
            },
            "tls": {
              "$ref": "#/$defs/TLS"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "vless",
            "tls"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "const": 1,
              "format": "bluegrass-int"
            },
            "type": {
              "const": "vless"
            },
            "vless": {
              "$ref": "#/$defs/VLESS"
            },
            "tls": {
              "$ref": "#/$defs/TLS"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "trojan",
            "tls"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "const": 1,
              "format": "bluegrass-int"
            },
            "type": {
              "const": "trojan"
            },
            "trojan": {
              "$ref": "#/$defs/Trojan"
            },
            "tls": {
              "$ref": "#/$defs/TLS"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "http"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "const": 1,
              "format": "bluegrass-int"
            },
            "type": {
              "const": "http"
            },
            "http": {
              "$ref": "#/$defs/HTTP"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "http",
            "tls"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "const": 1,
              "format": "bluegrass-int"
            },
            "type": {
              "const": "https"
            },
            "http": {
              "$ref": "#/$defs/HTTP"
            },
            "tls": {
              "allOf": [
                {
                  "$ref": "#/$defs/TLS"
                },
                {
                  "properties": {
                    "alpn": {
                      "items": {
                        "const": "http/1.1"
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "hysteria2",
            "tls"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "const": 1,
              "format": "bluegrass-int"
            },
            "type": {
              "const": "hysteria2"
            },
            "hysteria2": {
              "$ref": "#/$defs/Hysteria2"
            },
            "tls": {
              "allOf": [
                {
                  "$ref": "#/$defs/TLS"
                },
                {
                  "properties": {
                    "alpn": {
                      "items": {
                        "const": "h3"
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "tuic",
            "tls"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "const": 1,
              "format": "bluegrass-int"
            },
            "type": {
              "const": "tuic"
            },
            "tuic": {
              "$ref": "#/$defs/TUIC"
            },
            "tls": {
              "$ref": "#/$defs/TLS"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "anytls",
            "tls"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "const": 1,
              "format": "bluegrass-int"
            },
            "type": {
              "const": "anytls"
            },
            "anytls": {
              "$ref": "#/$defs/AnyTLS"
            },
            "tls": {
              "$ref": "#/$defs/TLS"
            }
          }
        }
      ]
    }
  }
}
