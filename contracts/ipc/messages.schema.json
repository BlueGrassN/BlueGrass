{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://bluegrass.invalid/contracts/ipc/messages.schema.json",
  "$ref":"#/$defs/ControlRequest",
  "$defs":{
    "ControlContext":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","clientEpoch","runtimeEpoch","logicalSessionId","attemptId","resourceKey"],
      "properties":{
        "schemaVersion":{"const":1},"clientEpoch":{"type":"string","minLength":1},
        "runtimeEpoch":{"type":"string","minLength":1},"logicalSessionId":{"type":"string","minLength":1},
        "attemptId":{"type":"string","minLength":1},
        "resourceKey":{"$ref":"../domain/resource.schema.json#/$defs/ResourceKey"}
      }
    },
    "ControlRequest":{
      "type":"object","additionalProperties":false,
      "required":["context","requestId","sequence","command","params"],
      "properties":{
        "context":{"$ref":"#/$defs/ControlContext"},"requestId":{"type":"string","minLength":1},
        "sequence":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "command":{"enum":["Connect","Pause","Disconnect","ReleaseProtection","ApplyResourceUpdate"]},
        "params":{"type":"object","additionalProperties":false,"properties":{
          "profile":{"$ref":"../domain/resource.schema.json#/$defs/ConnectionProfile"},
          "update":{"type":"object","additionalProperties":false,"required":["revision","validUntilUtc","unavailable"],"properties":{
            "revision":{"type":"integer","minimum":1,"maximum":9007199254740991},
            "validUntilUtc":{"type":["string","null"],"format":"date-time"},"unavailable":{"type":"boolean"},
            "profile":{"$ref":"../domain/resource.schema.json#/$defs/ConnectionProfile"}
          }}
        }}
      },
      "allOf":[
        {"if":{"properties":{"command":{"const":"Connect"}}},"then":{"properties":{"params":{"required":["profile"],"not":{"required":["update"]}}}}},
        {"if":{"properties":{"command":{"const":"ApplyResourceUpdate"}}},"then":{"properties":{"params":{"required":["update"],"not":{"required":["profile"]}}}}},
        {"if":{"properties":{"command":{"enum":["Pause","Disconnect","ReleaseProtection"]}}},"then":{"properties":{"params":{"maxProperties":0}}}}
      ]
    },
    "TrafficSnapshot":{
      "type":"object","additionalProperties":false,
      "required":["context","counterEpoch","sequence","monotonicNanos","uploadBytes","downloadBytes","available","complete"],
      "properties":{
        "context":{"$ref":"#/$defs/ControlContext"},"counterEpoch":{"type":"string","minLength":1},
        "sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "monotonicNanos":{"type":"integer","minimum":0,"maximum":9223372036854775807},
        "uploadBytes":{"type":"string","pattern":"^(0|[1-9][0-9]*)$","maxLength":20},
        "downloadBytes":{"type":"string","pattern":"^(0|[1-9][0-9]*)$","maxLength":20},
        "available":{"type":"boolean"},"complete":{"type":"boolean"}
      }
    },
    "NativeConfirmation":{
      "description":"Normalized reducer input, not the complete Go NativeSnapshot transport envelope.",
      "type":"object","additionalProperties":false,
      "required":["context","eventSequence","phase","protection","effectiveNowUtc"],
      "properties":{
        "context":{"$ref":"#/$defs/ControlContext"},
        "eventSequence":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "phase":{"enum":["idle","connecting","connected","pausing","paused","stopping","failed"]},
        "protection":{"enum":["unknown","inactive","blocking","forwarding"]},
        "effectiveNowUtc":{"type":"string","format":"date-time"},
        "verifiedExitIpv4":{"description":"Observed public IPv4, independent of expected metadata. Missing/null means connected IP unknown.","type":["string","null"],"format":"bluegrass-public-ipv4"},"isSnapshot":{"type":"boolean"}
      }
    }
  }
}
