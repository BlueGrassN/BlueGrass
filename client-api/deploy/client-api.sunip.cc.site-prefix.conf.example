# Add once at the top of client-api.sunip.cc.conf, OUTSIDE its server {} blocks.
# BaoTa normally includes this site file from http {}. Do not edit nginx.conf.
# The uniquely named zones are used only by this API site's proxy location.
limit_req_zone $binary_remote_addr zone=client_api_sunip_cc_ip:10m rate=10r/s;
limit_req_zone $server_name zone=client_api_sunip_cc_total:1m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=client_api_sunip_cc_conn_ip:10m;
limit_conn_zone $server_name zone=client_api_sunip_cc_conn_total:1m;
log_format client_api_sunip_cc_safe '$remote_addr [$time_local] "$request_method $uri" '
                                  '$status $body_bytes_sent $request_time';
