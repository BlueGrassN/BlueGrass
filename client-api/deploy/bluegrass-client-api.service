[Unit]
Description=BlueGrass Client API
After=network.target mysqld.service mysql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=bluegrass-api
Group=bluegrass-api
WorkingDirectory=/www/wwwroot/test-api.dos.im
ExecStart=/www/wwwroot/test-api.dos.im/bin/client-api -config /var/lib/bluegrass-client-api/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitNOFILE=16384
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
